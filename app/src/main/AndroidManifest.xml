<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
      Blade Wraith — Android Manifest
      Declares app capabilities, hardware requirements, and
      the entry Activity. Must be error-free for the app to
      launch on any Android 7.0+ device.
    ============================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ============================================================
          Hardware Features
          Declares that the app requires OpenGL ES 2.0.
          Google Play will filter out devices that don't support it.
          Reference: Android Developers — "Build an OpenGL ES environment"
        ============================================================
    -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!--
        Screen support: the game runs in landscape only.
        No portrait support is declared.
    -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="true" />

    <!--
        Touchscreen: required for the game's virtual joystick and buttons.
        Multitouch is not declared as required (most devices have it).
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!--
        ============================================================
          Permissions
          The game is fully offline; only vibration is needed
          for haptic feedback on hits and impacts.
        ============================================================
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        ============================================================
          Application
          Global settings for the entire app.
        ============================================================
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.BladeWraith"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!--
            ========================================================
              Main Activity
              The single entry point of the game.
              Configuration:
              - screenOrientation="sensorLandscape":
                  Forces landscape mode but respects the device's
                  natural landscape direction (normal or reverse).
                  Reference: Android game development — "Support
                  all screens"
              - configChanges: tells Android that the Activity
                  handles these changes itself, so it will NOT
                  be destroyed and recreated. This is critical
                  for OpenGL apps to avoid losing the GL context.
                  Reference: NVIDIA — "Bringing High-End 3D Games
                  to Android"
              - launchMode="singleTask": ensures only one instance
                  exists; returning to the app resumes the same
                  session instead of creating a new one.
            ========================================================
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode|density|fontScale"
            android:theme="@style/Theme.BladeWraith"
            android:hardwareAccelerated="true"
            android:resizeableActivity="false"
            tools:ignore="LockedOrientationActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Declare that this activity supports game controllers
                (optional, for future gamepad support).
            -->
            <meta-data
                android:name="android.max_aspect"
                android:value="2.4" />

        </activity>

        <!--
            ========================================================
              Meta-Data
              Application-level metadata for compatibility.
            ========================================================
        -->
        <meta-data
            android:name="android.app.lib_name"
            android:value="" />

        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!--
            ========================================================
              Disable Analytics / Tracking
              The game is fully offline; no analytics or crash
              reporting libraries are included.
            ========================================================
        -->

        <!--
            ========================================================
              Hardware Acceleration
              Ensures the entire app uses hardware-accelerated
              rendering. This is essential for OpenGL ES.
            ========================================================
        -->

        <!--
            ========================================================
              Backup Rules (Android 12+)
              Excludes sensitive data from cloud backups.
            ========================================================
        -->
        <meta-data
            android:name="android.content.backup_rules"
            android:resource="@xml/backup_rules" />

    </application>

</manifest>
